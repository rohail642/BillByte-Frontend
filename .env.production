# Production API base URL — baked into the build (web + Electron) by `vite build`.
# Without this, builds fall back to http://localhost:8000/api (see src/api/client.js).
VITE_API_URL=https://api.billbyte.co.in/api

# Android OTA (Capgo) — manifest the app polls on launch for silent updates.
# Must serve JSON: { "version": "x.y.z", "url": "https://.../billbyte-x.y.z.zip" }
VITE_OTA_MANIFEST_URL=https://app.billbyte.co.in/ota/latest.json
