{
  "name": "billbyte-react",
  "private": true,
  "version": "1.1.21",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:publish": "vite build && electron-builder --publish always",
    "android:sync": "vite build && cap sync android",
    "android:open": "vite build && cap sync android && cap open android",
    "android:apk": "vite build && cap sync android && cd android && gradlew.bat assembleRelease",
    "android:bundle": "vite build && cap sync android && cd android && gradlew.bat bundleRelease",
    "ota:zip": "node scripts/make-ota-bundle.mjs",
    "release": "node scripts/release-all.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "@capgo/capacitor-updater": "^6.45.10",
    "@tanstack/react-query": "^5.96.2",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "astral-regex": "^2.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.3",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.billbyte.pos",
    "productName": "BillByte POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BillByte POS"
    },
    "publish": {
      "provider": "github",
      "owner": "rohail642",
      "repo": "BillByte-Frontend",
      "releaseType": "release"
    }
  }
}
